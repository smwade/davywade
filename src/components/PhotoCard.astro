---
interface Props {
  src: string;
  id: string;
  width: number;
  height: number;
}

const { src, id, width, height } = Astro.props;
---

<div class="mb-2 break-inside-avoid">
  <img
    src={src}
    alt={id}
    width={width}
    height={height}
    loading="lazy"
    class="w-full rounded-lg shadow-2xl"
  />
</div>
