---
import PhotoCard from './PhotoCard.astro';
import photos from '../data/photos.json';
---

<div class="columns-1 sm:columns-2 lg:columns-3 gap-2 px-2 pt-2 pb-12 w-full max-w-none">
  {photos.map((photo) => (
    <PhotoCard 
      id={photo.id}
      src={photo.src}
      width={photo.width}
      height={photo.height}
    />
  ))}
</div>
