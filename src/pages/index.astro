---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
---

<Layout title="davywade.com | Photography">
	<main class="relative min-h-screen w-full m-0 p-0 overflow-x-hidden">
		<header class="pt-12 pb-12 text-center w-full">
			<h1 class="text-4xl sm:text-6xl font-extralight tracking-[0.2em] uppercase">
				davywade
			</h1>
		</header>

		<PhotoGallery />
	</main>
</Layout>
