---
import Layout from '../layouts/Layout.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
---

<Layout title="davywade.com | Photography">
	<main class="relative min-h-screen">
		<header class="pt-20 pb-10 text-center">
			<h1 class="text-4xl sm:text-6xl font-extralight tracking-[0.2em] uppercase">
				davywade
			</h1>
		</header>

		<PhotoGallery />

		<footer class="py-20 text-center">
			<p class="text-zinc-600 text-[10px] tracking-[0.3em] uppercase">
				&copy; {new Date().getFullYear()} davywade
			</p>
		</footer>
	</main>
</Layout>
